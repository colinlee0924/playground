<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <!-- add our i18n resource -->
    <resource type="i18n" name="i18n" location="JiraMCPServer"/>
    
    <!-- add our web resources -->
    <web-resource key="JiraMCPServer-resources" name="JiraMCPServer Web Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        
        <resource type="download" name="JiraMCPServer.css" location="/css/JiraMCPServer.css"/>
        <resource type="download" name="JiraMCPServer.js" location="/js/JiraMCPServer.js"/>
        <resource type="download" name="images/" location="/images"/>

        <context>JiraMCPServer</context>
    </web-resource>
    
    <!-- MCP Server Servlet -->
    <servlet name="MCP Server Servlet" key="mcpServerServlet" class="com.hanlinuniverse.playground.JiraMCPServer.servlet.McpServlet">
        <description>Provides MCP protocol endpoints for AI integration</description>
        <url-pattern>/mcp/*</url-pattern>
    </servlet>
    
    <!-- MCP Configuration Servlet -->
    <servlet name="MCP Configuration Servlet" key="mcpConfigServlet" class="com.hanlinuniverse.playground.JiraMCPServer.servlet.ConfigServlet">
        <description>Configuration UI for MCP Server</description>
        <url-pattern>/mcp-config</url-pattern>
    </servlet>
    
    <!-- Hello World Servlet (Example) -->
    <servlet name="Hello World Servlet" key="helloWorldServlet" class="com.example.servlets.HelloWorldServlet">
        <description>A simple servlet that says hello.</description>
        <url-pattern>/hello</url-pattern>
        <init-param>
            <param-name>defaultName</param-name>
            <param-value>Atlassian User</param-value>
        </init-param>
    </servlet>
</atlassian-plugin>