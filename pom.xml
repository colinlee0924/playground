    <build>
        <plugins>
            <!-- Replace the jira-maven-plugin configuration with this -->
            <plugin>
                <groupId>com.atlassian.maven.plugins</groupId>
                <artifactId>jira-maven-plugin</artifactId>
                <version>${amps.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <productVersion>${jira.version}</productVersion>
                    <productDataVersion>${jira.version}</productDataVersion>
                    <startupTimeout>36000000</startupTimeout>
                    <jvmArgs>-Xms8192m -Xmx12288m --add-opens java.base/jdk.internal.misc=ALL-UNNAMED</jvmArgs>
                    <enableQuickReload>true</enableQuickReload>
                    <banningExcludes>
                        <exclude>com.google.code.findbugs:jsr305</exclude>
                        <exclude>com.fasterxml.jackson.core:jackson-annotations</exclude>
                        <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                        <exclude>net.bytebuddy:byte-buddy</exclude>
                        <exclude>jakarta.servlet:jakarta.servlet-api</exclude>
                        <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    </banningExcludes>
                </configuration>
            </plugin>
            
            <!-- Add the Maven Bundle Plugin -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.8</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>bundle-manifest</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>manifest</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <instructions>
                        <Atlassian-Plugin-Key>${atlassian.plugin.key}</Atlassian-Plugin-Key>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Export-Package>
                            com.hanlinuniverse.playground.JiraMCPServer.api;version="${project.version}"
                        </Export-Package>
                        <Import-Package>
                            org.springframework.osgi.*;resolution:="optional",
                            org.eclipse.gemini.blueprint.*;resolution:="optional",
                            com.atlassian.*;resolution:="mandatory",
                            javax.servlet.*;resolution:="mandatory",
                            javax.ws.rs.*;resolution:="mandatory",
                            !jdk.internal.*,
                            !com.sun.jna.*,
                            !javax.annotation.meta.*,
                            !com.fasterxml.jackson.*,
                            !reactor.core.*,
                            !io.micrometer.*,
                            !ch.qos.logback.*,
                            *;resolution:=optional
                        </Import-Package>
                        <Embed-Dependency>
                            jackson-core,
                            jackson-databind,
                            jackson-annotations,
                            jna,
                            jsr305,
                            reactive-streams,
                            reactor-core,
                            context-propagation,
                            micrometer-core,
                            logback-classic,
                            logback-core,
                            mcp;inline=false
                        </Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <DynamicImport-Package>jdk.internal.*</DynamicImport-Package>
                        <Spring-Context>*</Spring-Context>
                        
                        <!-- This ensures we use the manifest generated by the maven-bundle-plugin -->
                        <_plugin>org.apache.felix.bundleplugin.BundlePlugin</_plugin>
                    </instructions>
                    <supportedProjectTypes>
                        <supportedProjectType>atlassian-plugin</supportedProjectType>
                    </supportedProjectTypes>
                </configuration>
            </plugin>
            
            <!-- Keep the atlassian-spring-scanner-maven-plugin as it was -->
            <plugin>
                <groupId>com.atlassian.plugin</groupId>
                <artifactId>atlassian-spring-scanner-maven-plugin</artifactId>
                <version>${atlassian.spring.scanner.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>atlassian-spring-scanner</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
                <configuration>
                    <verbose>false</verbose>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <jira.version>9.12.2</jira.version>
        <amps.version>9.1.1</amps.version>
        <plugin.testrunner.version>2.0.9</plugin.testrunner.version>
        <atlassian.spring.scanner.version>2.2.4</atlassian.spring.scanner.version>
        <!-- This property ensures consistency between the key in atlassian-plugin.xml and the OSGi bundle's key. -->
        <atlassian.plugin.key>${project.groupId}.${project.artifactId}</atlassian.plugin.key>
        <!-- TestKit version 6.x for JIRA 6.x -->
        <testkit.version>6.3.11</testkit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

